{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwitchOS Hub",
  "version": "0.0.1",
  "identifier": "br.com.mastersys.switchos.hub",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SwitchOS Hub",
        "width": 1180,
        "height": 720,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}